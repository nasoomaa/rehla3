{
    "name": "rehla/web",
    "description": "Rehla Web Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/catalog": "@dev",
        "rehla/forms": "@dev",
        "rehla/travelers": "@dev",
        "rehla/documents": "@dev",
        "rehla/wallet": "@dev",
        "rehla/topups": "@dev",
        "rehla/orders": "@dev",
        "rehla/fulfillment": "@dev",
        "rehla/purchasing": "@dev",
        "rehla/notifications": "@dev",
        "rehla/content": "@dev",
        "rehla/integrations": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Web\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Web\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Web\\WebServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
