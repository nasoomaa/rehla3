{
    "name": "rehla/reporting",
    "description": "Rehla Reporting Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/travelers": "@dev",
        "rehla/catalog": "@dev",
        "rehla/topups": "@dev",
        "rehla/orders": "@dev",
        "rehla/fulfillment": "@dev",
        "rehla/notifications": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Reporting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Reporting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Reporting\\ReportingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
