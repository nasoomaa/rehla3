{
    "name": "rehla/wallet",
    "description": "Rehla Wallet Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Wallet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Wallet\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Wallet\\WalletServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
