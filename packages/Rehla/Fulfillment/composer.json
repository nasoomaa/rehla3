{
    "name": "rehla/fulfillment",
    "description": "Rehla Fulfillment Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/orders": "@dev",
        "rehla/forms": "@dev",
        "rehla/documents": "@dev",
        "rehla/purchasing": "@dev",
        "rehla/audit": "@dev",
        "rehla/notifications": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Fulfillment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Fulfillment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Fulfillment\\FulfillmentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
