{
    "name": "rehla/audit",
    "description": "Rehla Audit Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Audit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Audit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Audit\\AuditServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
