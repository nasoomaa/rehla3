{
    "name": "rehla/core",
    "description": "Rehla Core Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^2.71 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Core\\CoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
