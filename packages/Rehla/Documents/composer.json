{
    "name": "rehla/documents",
    "description": "Rehla Documents Package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "rehla/core": "@dev",
        "rehla/identity": "@dev",
        "rehla/audit": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Rehla\\Documents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rehla\\Documents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rehla\\Documents\\DocumentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
